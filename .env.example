# AFTERHOURS Portfolio — External Configuration
# Copy this file to `.env` and fill in your verified values when ready.

# Production Deployment Base URL (e.g., https://your-portfolio.vercel.app — no trailing slash)
# Used for canonical URL and Open Graph / Twitter social preview image absolute URLs.
# On Vercel, if left blank, VERCEL_PROJECT_PRODUCTION_URL is used automatically.
VITE_SITE_URL=

# Verified Contact Email (used by the mailto: fallback & Copy Email button)
VITE_CONTACT_EMAIL=espanojohnpaul28@gmail.com

# Optional future backend endpoint (e.g., https://api.web3forms.com/submit or Formspree URL)
VITE_CONTACT_ENDPOINT=

# Verified Social Profile URLs
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Resume file path (set to /resume.pdf once placed in public/resume.pdf)
VITE_RESUME_URL=

# Optional Project Screenshot Paths (e.g., /assets/projects/nexus-payroll.png)
VITE_NEXUS_SCREENSHOT_URL=
VITE_POS_SCREENSHOT_URL=
VITE_SMARTSPEND_SCREENSHOT_URL=

# Optional Creative Reel Video Paths (e.g., /assets/creative/reel-01.mp4)
VITE_REEL_01_URL=
VITE_REEL_02_URL=
VITE_REEL_03_URL=
VITE_REEL_04_URL=

# Optional Project Live Demo & Source Repository URLs
VITE_NEXUS_DEMO_URL=
VITE_NEXUS_REPO_URL=
VITE_POS_DEMO_URL=
VITE_POS_REPO_URL=
VITE_SMARTSPEND_DEMO_URL=
VITE_SMARTSPEND_REPO_URL=

